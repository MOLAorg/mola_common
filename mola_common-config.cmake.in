# mola_common: Defined common CMake variables and functions to unify building
# of all MOLA modules.
#
# Main functions (refer to their docs in mola_cmake_functions.cmake):
#  - mola_add_library()
#  - mola_add_executable()
#

# The CMake functions are installed next to this file. Only paths relative to
# it are used, so the installed package can be moved (e.g. inside a Python
# wheel):
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")


include(mola_cmake_functions)
